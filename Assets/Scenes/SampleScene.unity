  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Sluggy can equip one of 4 colors(Red,Blue,Green & White)\n\nThere is a
    complimentary color and detrimental color for each color \n\nYou can collect
    the incoming particles - according to Sluggy's color\n\nCollecting a particle
    with the same color as Sluggy's will get you a point\n\nCollecting a particle
    with  a complimentary color will get you 2 points and Sluggy will change its
    color to that color\n\nCollecting a particle with a detrimental color will cost
    you -2 points and Sluggy will change its color to white(Panic Mode)\n\nCollecting
    a white particle while Sluggy has one of the Primary colors(Red/Blue/Green) will
    cost you -5 points and Sluggy goes into Panic Mode\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c18d470c4d95ced49aa122411cabfd3b, type: 2}
